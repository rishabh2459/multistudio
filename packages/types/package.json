{
  "name": "@multicam/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript types generated from the Python data model (schemas/multicam.schema.json).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.6.0"
  }
}
