{
  "$defs": {
    "AudioConfig": {
      "additionalProperties": false,
      "properties": {
        "gains_db": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "format": "uuid"
          },
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/AudioMode",
          "default": "mix"
        },
        "single_clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "gains_db",
        "single_clip_id"
      ],
      "title": "AudioConfig",
      "type": "object"
    },
    "AudioMode": {
      "enum": [
        "mix",
        "single"
      ],
      "title": "AudioMode",
      "type": "string"
    },
    "AudioTrack": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "format": "uuid",
          "type": "string"
        },
        "gain_db": {
          "default": 0.0,
          "type": "number"
        },
        "index": {
          "minimum": 1,
          "type": "integer"
        },
        "pieces": {
          "items": {
            "$ref": "#/$defs/PlanPiece"
          },
          "type": "array"
        }
      },
      "required": [
        "index",
        "clip_id",
        "gain_db",
        "pieces"
      ],
      "title": "AudioTrack",
      "type": "object"
    },
    "CameraLayout": {
      "additionalProperties": false,
      "description": "One camera (clip), what kind of shot it is and who is visible in it.",
      "properties": {
        "clip_id": {
          "format": "uuid",
          "type": "string"
        },
        "covers": {
          "description": "Speaker ids in frame",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "priority": {
          "default": 1.0,
          "description": "User bias for this angle",
          "maximum": 1.5,
          "minimum": 0.5,
          "type": "number"
        },
        "shot": {
          "$ref": "#/$defs/ShotType"
        }
      },
      "required": [
        "clip_id",
        "shot",
        "covers",
        "priority"
      ],
      "title": "CameraLayout",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path": {
          "description": "Absolute path; files are referenced in place",
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ClipRole",
          "default": "speaker"
        },
        "speaker_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sync": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "path",
        "role",
        "speaker_label",
        "media",
        "sync"
      ],
      "title": "Clip",
      "type": "object"
    },
    "ClipRole": {
      "enum": [
        "speaker",
        "wide",
        "broll",
        "mic"
      ],
      "title": "ClipRole",
      "type": "string"
    },
    "CutList": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioConfig"
        },
        "fps": {
          "$ref": "#/$defs/Rational"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "removals": {
          "items": {
            "$ref": "#/$defs/Removal"
          },
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "minItems": 1,
          "type": "array"
        },
        "version": {
          "default": 1,
          "description": "Edit revision; bumps on every change",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "version",
        "project_id",
        "fps",
        "segments",
        "removals",
        "audio"
      ],
      "title": "CutList",
      "type": "object"
    },
    "EditPlan": {
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audio_mode": {
          "$ref": "#/$defs/AudioMode",
          "default": "mix"
        },
        "audio_tracks": {
          "items": {
            "$ref": "#/$defs/AudioTrack"
          },
          "type": "array"
        },
        "cutlist_version": {
          "type": "integer"
        },
        "host": {
          "$ref": "#/$defs/HostApp",
          "default": "generic"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/PlanMarker"
          },
          "type": "array"
        },
        "media": {
          "items": {
            "$ref": "#/$defs/PlanMedia"
          },
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/PlanMethod",
          "default": "stacked_enable"
        },
        "overlays": {
          "items": {
            "$ref": "#/$defs/PlanOverlay"
          },
          "type": "array"
        },
        "plan_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "removals": {
          "description": "Approved only",
          "items": {
            "$ref": "#/$defs/PlanRemoval"
          },
          "type": "array"
        },
        "rippled": {
          "default": false,
          "type": "boolean"
        },
        "sequence": {
          "$ref": "#/$defs/PlanSequence"
        },
        "video_events": {
          "items": {
            "$ref": "#/$defs/VideoEvent"
          },
          "type": "array"
        },
        "video_tracks": {
          "items": {
            "$ref": "#/$defs/VideoTrack"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "plan_version",
        "project_id",
        "cutlist_version",
        "host",
        "method",
        "sequence",
        "media",
        "video_events",
        "video_tracks",
        "audio_mode",
        "audio_tracks",
        "removals",
        "markers",
        "overlays",
        "aspect",
        "rippled",
        "warnings"
      ],
      "title": "EditPlan",
      "type": "object"
    },
    "GTClip": {
      "additionalProperties": false,
      "properties": {
        "clap_end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clap_start_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "File name inside the recording folder",
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ClipRole",
          "default": "speaker"
        },
        "speaker_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "file",
        "role",
        "speaker_label",
        "clap_start_ms",
        "clap_end_ms"
      ],
      "title": "GTClip",
      "type": "object"
    },
    "GroundTruth": {
      "additionalProperties": false,
      "properties": {
        "annotated_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/MsRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Window (reference timeline) where speech is fully labeled. None = whole recording. Speaker-accuracy is scored only inside it."
        },
        "clips": {
          "items": {
            "$ref": "#/$defs/GTClip"
          },
          "minItems": 2,
          "type": "array"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "recording_id": {
          "pattern": "^T\\d+$",
          "type": "string"
        },
        "reference_file": {
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "speech": {
          "items": {
            "$ref": "#/$defs/SpeechTurn"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "recording_id",
        "description",
        "reference_file",
        "clips",
        "speech",
        "annotated_range"
      ],
      "title": "GroundTruth",
      "type": "object"
    },
    "HostApp": {
      "enum": [
        "premiere",
        "resolve",
        "fcp",
        "generic"
      ],
      "title": "HostApp",
      "type": "string"
    },
    "MarkerColor": {
      "enum": [
        "red",
        "yellow",
        "green",
        "blue"
      ],
      "title": "MarkerColor",
      "type": "string"
    },
    "MediaInfo": {
      "additionalProperties": false,
      "description": "Facts about a source file, read with ffprobe (Phase 1).\n\nSound-only files (``has_video`` false) count frames at ``AUDIO_ONLY_FPS`` and\nhave width = height = 0.",
      "properties": {
        "audio_channels": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "audio_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audio_sample_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_frames": {
          "minimum": 0,
          "type": "integer"
        },
        "fps": {
          "$ref": "#/$defs/Rational"
        },
        "has_video": {
          "default": true,
          "type": "boolean"
        },
        "height": {
          "minimum": 0,
          "type": "integer"
        },
        "is_vfr": {
          "type": "boolean"
        },
        "start_timecode": {
          "anyOf": [
            {
              "pattern": "^\\d{2}:\\d{2}:\\d{2}[:;.]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Embedded start timecode (HH:MM:SS:FF, ';' before FF = drop-frame)"
        },
        "video_codec": {
          "type": "string"
        },
        "width": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fps",
        "is_vfr",
        "has_video",
        "duration_frames",
        "width",
        "height",
        "video_codec",
        "audio_codec",
        "audio_sample_rate",
        "audio_channels",
        "start_timecode"
      ],
      "title": "MediaInfo",
      "type": "object"
    },
    "MsRange": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "MsRange",
      "type": "object"
    },
    "OutputSettings": {
      "additionalProperties": false,
      "properties": {
        "fps": {
          "$ref": "#/$defs/Rational"
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fps",
        "width",
        "height"
      ],
      "title": "OutputSettings",
      "type": "object"
    },
    "PlanMarker": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/MarkerColor",
          "default": "yellow"
        },
        "duration": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "frame": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "default": "note",
          "enum": [
            "low_confidence",
            "removal",
            "note"
          ],
          "type": "string"
        },
        "note": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "duration",
        "color",
        "kind",
        "note"
      ],
      "title": "PlanMarker",
      "type": "object"
    },
    "PlanMedia": {
      "additionalProperties": false,
      "description": "One source file (camera or recorder).",
      "properties": {
        "angle": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "1-based multicam angle (cameras only)"
        },
        "audio_channels": {
          "type": "integer"
        },
        "audio_track": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "1-based audio track, if its audio is used"
        },
        "clip_id": {
          "format": "uuid",
          "type": "string"
        },
        "drift_ppm": {
          "default": 0.0,
          "type": "number"
        },
        "duration_frames": {
          "description": "At the media's own frame rate",
          "minimum": 0,
          "type": "integer"
        },
        "fps": {
          "$ref": "#/$defs/Rational"
        },
        "has_audio": {
          "type": "boolean"
        },
        "has_timecode": {
          "type": "boolean"
        },
        "height": {
          "type": "integer"
        },
        "host_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The host's id of this media item"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "record_start_frame": {
          "description": "Sequence frame where the media's first frame lands (< 0: starts before the sequence). Approximate under clock drift; pieces carry exact source times.",
          "type": "integer"
        },
        "sample_rate": {
          "type": "integer"
        },
        "shot": {
          "$ref": "#/$defs/ShotType"
        },
        "start_timecode_frames": {
          "description": "Embedded start timecode, own-rate frames",
          "type": "integer"
        },
        "video_track": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "1-based track for stacked_enable"
        },
        "width": {
          "type": "integer"
        }
      },
      "required": [
        "clip_id",
        "path",
        "name",
        "label",
        "host_ref",
        "fps",
        "duration_frames",
        "width",
        "height",
        "has_audio",
        "audio_channels",
        "sample_rate",
        "start_timecode_frames",
        "has_timecode",
        "shot",
        "angle",
        "video_track",
        "audio_track",
        "record_start_frame",
        "drift_ppm"
      ],
      "title": "PlanMedia",
      "type": "object"
    },
    "PlanMethod": {
      "enum": [
        "cuts",
        "stacked_enable",
        "multicam"
      ],
      "title": "PlanMethod",
      "type": "string"
    },
    "PlanOverlay": {
      "additionalProperties": false,
      "description": "A picture above the edit (watermark / logo) on its own video track.",
      "properties": {
        "clip_id": {
          "format": "uuid",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "source_in_frame": {
          "description": "Frames at the media's own rate (nearest)",
          "type": "integer"
        },
        "source_in_sample": {
          "description": "Samples at the media's audio rate (nearest)",
          "type": "integer"
        },
        "source_in_ticks": {
          "description": "Premiere ticks (254016000000 per second)",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "track": {
          "description": "1 = first track above the cameras",
          "minimum": 1,
          "type": "integer"
        },
        "transform": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PlanTransformKey"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "start",
        "end",
        "clip_id",
        "source_in_frame",
        "source_in_sample",
        "source_in_ticks",
        "track",
        "opacity",
        "transform"
      ],
      "title": "PlanOverlay",
      "type": "object"
    },
    "PlanPiece": {
      "additionalProperties": false,
      "description": "Sequence frames [start, end) show the media from ``source_in``.",
      "properties": {
        "clip_id": {
          "format": "uuid",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "source_in_frame": {
          "description": "Frames at the media's own rate (nearest)",
          "type": "integer"
        },
        "source_in_sample": {
          "description": "Samples at the media's audio rate (nearest)",
          "type": "integer"
        },
        "source_in_ticks": {
          "description": "Premiere ticks (254016000000 per second)",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "clip_id",
        "source_in_frame",
        "source_in_sample",
        "source_in_ticks"
      ],
      "title": "PlanPiece",
      "type": "object"
    },
    "PlanRemoval": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "kind"
      ],
      "title": "PlanRemoval",
      "type": "object"
    },
    "PlanSequence": {
      "additionalProperties": false,
      "properties": {
        "duration_frames": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "fps": {
          "$ref": "#/$defs/Rational"
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "host_start_frame": {
          "default": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "fps",
        "width",
        "height",
        "duration_frames",
        "host_start_frame"
      ],
      "title": "PlanSequence",
      "type": "object"
    },
    "PlanTransformKey": {
      "additionalProperties": false,
      "description": "Where the media sits at one sequence frame, in the host's Motion terms.\n\n``scale`` is percent of the media's native size (Premiere Motion > Scale) and\n``x``/``y`` the media's centre in sequence pixels (Motion > Position). Hosts\ninterpolate linearly between keys and hold outside them.",
      "properties": {
        "frame": {
          "description": "Sequence frame",
          "minimum": 0,
          "type": "integer"
        },
        "scale": {
          "description": "Percent of the media's native size",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "x": {
          "description": "Media centre, sequence pixels from the left",
          "type": "number"
        },
        "y": {
          "description": "Media centre, sequence pixels from the top",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "scale",
        "x",
        "y"
      ],
      "title": "PlanTransformKey",
      "type": "object"
    },
    "Preset": {
      "enum": [
        "calm",
        "balanced",
        "dynamic",
        "punchy"
      ],
      "title": "Preset",
      "type": "string"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "cameras": {
          "items": {
            "$ref": "#/$defs/CameraLayout"
          },
          "maxItems": 10,
          "type": "array"
        },
        "clips": {
          "items": {
            "$ref": "#/$defs/Clip"
          },
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/OutputSettings"
        },
        "preset": {
          "$ref": "#/$defs/Preset",
          "default": "balanced"
        },
        "reference_clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "speakers": {
          "items": {
            "$ref": "#/$defs/Speaker"
          },
          "maxItems": 10,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "output",
        "preset",
        "clips",
        "reference_clip_id",
