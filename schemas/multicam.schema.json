    "Reframe": {
      "additionalProperties": false,
      "description": "Crop/zoom for a segment. Normalized coordinates (0..1) of the crop centre.\n\nThe crop has the output's aspect ratio; ``scale`` 1 is the largest such crop\n(the full frame when source and output have the same shape), 2 shows half\nthe width. With ``path`` the centre follows those keyframes (a slow pan that\nkeeps a face framed); ``cx``/``cy`` are then the starting point.",
      "properties": {
        "cx": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "cy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "manual": {
          "default": false,
          "description": "Set by the user: auto framing keeps it",
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ReframeKey"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scale": {
          "maximum": 4.0,
          "minimum": 1.0,
          "type": "number"
        }
      },
      "required": [
        "cx",
        "cy",
        "scale",
        "path",
        "manual"
      ],
      "title": "Reframe",
      "type": "object"
    },
    "ReframeKey": {
      "additionalProperties": false,
      "description": "Crop centre at one timeline frame; the render moves linearly between keys.",
      "properties": {
        "cx": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "cy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "frame": {
          "description": "Timeline frame",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "frame",
        "cx",
        "cy"
      ],
      "title": "ReframeKey",
      "type": "object"
    },
