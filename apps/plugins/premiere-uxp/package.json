{
  "name": "@multicam/premiere-uxp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multicam Studio panel for Adobe Premiere Pro (UXP, Premiere 25.6+).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
